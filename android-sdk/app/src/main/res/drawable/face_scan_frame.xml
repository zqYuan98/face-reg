<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 边框 -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/tech_primary_dim"/>
            <solid android:color="@color/transparent"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    
    <!-- 四角加粗效果 (通过 inset 实现模拟) -->
    <!-- 这里简化处理，实际可能需要自定义 View 或更复杂的 drawable -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
         <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/tech_primary"
                    android:dashWidth="40dp" android:dashGap="200dp"/> 
            <corners android:radius="16dp"/>
         </shape>
    </item>
</layer-list>
