# Build context: FaceFeatureExtractorAPI. BASE_IMAGE must be the exact deployed
# image retaining the original feature_server.py version 1.1.0 (tag pinned to
# its image ID, or a registry digest), including an earlier comparison overlay.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG VCS_REF
LABEL org.opencontainers.image.revision="${VCS_REF}"
LABEL org.opencontainers.image.description="Existing feature service plus vector comparison and search"
WORKDIR /app

# Copy only the model-free comparison dependency closure. Keep the original
# feature_server.py, extractor, models, configuration and Python environment.
COPY api/__init__.py api/feature_comparison.py api/feature_search.py api/search_execution.py api/body_limit.py api/deadline.py api/errors.py ./api/
COPY face_algorithm/__init__.py face_algorithm/schemas.py ./face_algorithm/
COPY face_algorithm/core/__init__.py face_algorithm/core/protocols.py face_algorithm/core/matcher.py face_algorithm/core/search.py ./face_algorithm/core/
COPY runtime_env.py image_runtime_options.py feature_comparison_server.py ./

RUN python -c "from feature_comparison_server import app; assert app.version == '1.3.0'; assert set(app.openapi()['paths']) == {'/health', '/ready', '/api/detect_face', '/api/extract_feature', '/api/compare_feature', '/api/search_feature'}"
CMD ["python", "feature_comparison_server.py", "--port", "8000"]
