<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bonuos.face.mapper.AdminQueryMapper">
    <resultMap id="userListItem" type="com.bonuos.face.dto.UserListItem">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="user_no" javaType="java.lang.String"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="group_id" javaType="java.lang.Long"/>
            <arg column="group_name" javaType="java.lang.String"/>
            <arg column="photo_url" javaType="java.lang.String"/>
            <arg column="has_feature" javaType="_boolean"/>
            <arg column="status" javaType="java.lang.Integer"/>
            <arg column="create_time" javaType="java.time.LocalDateTime"/>
            <arg column="update_time" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <resultMap id="groupOption" type="com.bonuos.face.dto.GroupOption">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="group_name" javaType="java.lang.String"/>
            <arg column="group_no" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <sql id="userPredicates">
        WHERE u.status = 1
        <if test="namePattern != null">
            AND u.name LIKE #{namePattern} ESCAPE '!'
        </if>
        <if test="groupId != null">
            AND u.group_id = #{groupId}
        </if>
    </sql>

    <sql id="groupKeywordPredicate">
        <if test="keywordPattern != null">
            AND g.group_name LIKE #{keywordPattern} ESCAPE '!'
        </if>
    </sql>

    <!-- LIMIT/OFFSET and COUNT apply only to IDs. The covering index skips wide feature rows. -->
    <select id="selectUserIdsPage" resultType="long">
        SELECT u.id FROM sys_user u
        <include refid="userPredicates"/>
        ORDER BY u.create_time DESC, u.id DESC
    </select>

    <!-- Called only with the bounded IDs from one page, in the same repeatable-read transaction. -->
    <select id="selectUserDetailsByIds" resultMap="userListItem">
        SELECT u.id, u.user_no, u.name, u.group_id, g.group_name, u.photo_url,
               CASE WHEN CHAR_LENGTH(u.feature_data) &gt; 20 THEN 1 ELSE 0 END AS has_feature,
               u.status, u.create_time, u.update_time
        FROM sys_user u
        LEFT JOIN sys_user_group g ON g.id = u.group_id
        WHERE u.status = 1 AND u.id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY u.create_time DESC, u.id DESC
    </select>

    <select id="selectGroupPage" resultType="com.bonuos.face.entity.UserGroup">
        SELECT g.id, g.group_no, g.group_name, g.description, g.create_time, g.update_time
        FROM sys_user_group g
        WHERE 1 = 1
        <include refid="groupKeywordPredicate"/>
        ORDER BY g.id DESC
    </select>

    <select id="selectGroupOptions" resultMap="groupOption">
        SELECT g.id, g.group_name, g.group_no
        FROM sys_user_group g
        WHERE g.id &gt; #{afterId}
        <include refid="groupKeywordPredicate"/>
        ORDER BY g.id ASC
        LIMIT #{take}
    </select>

    <select id="countGroups" resultType="long">
        SELECT COUNT(*) FROM sys_user_group
    </select>

    <!-- Probe only IDs, never face features, before allowing a legacy response. -->
    <select id="selectLegacyUserIds" resultType="long">
        SELECT u.id FROM sys_user u
        <include refid="userPredicates"/>
        ORDER BY u.create_time DESC, u.id DESC
        LIMIT 101
    </select>

    <select id="selectLegacyUsersByIds" resultType="com.bonuos.face.entity.User">
        SELECT u.id, u.user_no, u.name, u.group_id, u.feature_data, u.photo_url,
               u.status, u.create_time, u.update_time
        FROM sys_user u
        WHERE u.status = 1 AND u.id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY u.create_time DESC, u.id DESC
    </select>

    <select id="selectLegacyGroupIds" resultType="long">
        SELECT g.id FROM sys_user_group g
        ORDER BY g.id DESC
        LIMIT 101
    </select>

    <select id="selectLegacyGroupsByIds" resultType="com.bonuos.face.entity.UserGroup">
        SELECT g.id, g.group_no, g.group_name, g.description, g.create_time, g.update_time
        FROM sys_user_group g
        WHERE g.id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY g.id DESC
    </select>
</mapper>
